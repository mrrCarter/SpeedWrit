# Allow only source/manifests needed by this image into the build context.
**
!package.json
!package-lock.json
!packages/
!packages/job-send/
!packages/job-send/package.json
!packages/job-send/tsconfig.json
!packages/job-send/src/
!packages/job-send/src/**
!packages/job-send-ui/
!packages/job-send-ui/package.json
!packages/job-send-ui/tsconfig.json
!packages/job-send-ui/scripts/
!packages/job-send-ui/scripts/build-owner-app.mjs
!packages/job-send-ui/src/
!packages/job-send-ui/src/**
!packages/job-send-app/
!packages/job-send-app/package.json
!packages/job-send-app/tsconfig.json
!packages/job-send-app/scripts/
!packages/job-send-app/scripts/build.mjs
!packages/job-send-app/src/
!packages/job-send-app/src/**
!deploy/
!deploy/g1/
!deploy/g1/Dockerfile
!deploy/g1/Dockerfile.dockerignore

# Private files and local artifacts stay excluded even inside allowed folders.
**/.env
**/.env.*
**/*.env
**/*.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/.npmrc
**/.git
**/.git/**
**/node_modules
**/node_modules/**
**/dist
**/dist/**
**/tasks
**/tasks/**
**/logs
**/logs/**
**/*.log
**/coverage
**/coverage/**
**/test-results
**/test-results/**
