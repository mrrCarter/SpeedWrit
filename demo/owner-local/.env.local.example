# Copy to .env.local (gitignored) and fill in. Never commit or paste these.
DIAL_API_KEY=
# Your Dial number in E.164, or its id/nickname.
DIAL_NUMBER=
# The phone that receives alerts, in E.164.
ALERT_PHONE=+1XXXXXXXXXX
# Live calls only with an explicit opt-in. Anything else is a dry run.
DIAL_LIVE=0
